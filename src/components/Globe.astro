---
// Dotted 3D globe: dim dots on land that fade towards the limb, slow auto-spin,
// drag (mouse or touch) to rotate.
---

<div class="relative h-full w-full cursor-grab touch-none select-none active:cursor-grabbing" data-globe>
	<canvas class="block h-full w-full" aria-label="Rotating dotted globe, drag to turn it, scroll or pinch to zoom" role="img"></canvas>
</div>

<script>
	import * as THREE from 'three';
	import { feature } from 'topojson-client';
	// 1:50m Natural Earth land, loaded as a separate cached asset (not bundled into JS).
	import landUrl from 'world-atlas/land-50m.json?url';

	const RADIUS = 1;
	const ROW_STEP_DEG = 0.7; // spacing between dots in degrees (~78 km); smaller = denser
	const DOT_SIZE = 0.0041;
	const MIN_DOT_PIXELS = 2.5; // dots never draw smaller than this; avoids moiré when zoomed out
	const MASK_WIDTH = 4096; // land-mask resolution (~10 km per pixel at the equator)

	const DOT_COLOR = new THREE.Color('#c2c2c2'); // dots facing you
	const EDGE_COLOR = new THREE.Color('#383838'); // dots at the rim

	// Raised blue markers.
	const MARKERS = [
		{ name: 'Bucharest', lat: 44.4268, lon: 26.1025 },
		{ name: 'Dortmund', lat: 51.5136, lon: 7.4653 },
		{ name: 'Copenhagen', lat: 55.6761, lon: 12.5683 },
		{ name: 'Monaco', lat: 43.7384, lon: 7.4246 },
		{ name: 'Alicante', lat: 38.3452, lon: -0.481 },
	];
	const MARKER_COLOR = new THREE.Color('#3b82f6');
	const MARKER_HEIGHT = 0.025; // how far above the surface (globe radius = 1)
	const MARKER_SIZE = 0.009;
	const BODY_COLOR = 0x121212;

	const SPIN_SPEED = 0.06; // auto-rotation, radians per second
	const TILT = 0.38; // initial tip of the north towards the viewer
	const MAX_TILT = 1.2; // limit for dragging up/down
	const START_LON = 10; // longitude facing the camera at load (Europe)
	const INERTIA_DECAY = 4; // higher = drag momentum stops sooner
	const MAX_FLING = 5; // cap on release speed, radians per second
	const MIN_CAMERA_DISTANCE = 1.5; // closest zoom, from the globe's centre (radius = 1)
	const MAX_ZOOM_OUT = 1.6; // farthest zoom, relative to the "whole globe" view
	const ZOOM_EASE = 10; // higher = zoom settles faster
	const RESUME_DELAY = 1.5; // seconds after release before auto-spin is fully back

	/**
	 * Make longitudes continuous (no 360° jumps at the antimeridian). A ring that
	 * circles a pole (Antarctica) is closed along that pole so it fills correctly.
	 */
	function unwrapRing(ring: number[][]) {
		const out: number[][] = [];
		let shift = 0;
		ring.forEach(([lon, lat], i) => {
			if (i > 0) {
				const prev = ring[i - 1][0];
				if (lon - prev > 180) shift -= 360;
				else if (prev - lon > 180) shift += 360;
			}
			out.push([lon + shift, lat]);
		});
		const first = out[0];
		const last = out[out.length - 1];
		if (Math.abs(last[0] - first[0]) > 180) {
			const meanLat = out.reduce((s, p) => s + p[1], 0) / out.length;
			const pole = meanLat < 0 ? -90 : 90;
			out.push([last[0], pole], [first[0], pole]);
		}
		return out;
	}

	/** Rasterise land polygons onto an equirectangular canvas we can sample. */
	function buildLandMask(topo: any, width = MASK_WIDTH, height = MASK_WIDTH / 2) {
		const canvas = document.createElement('canvas');
		canvas.width = width;
		canvas.height = height;
		const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
		const land = feature(topo, topo.objects.land) as GeoJSON.FeatureCollection | GeoJSON.Feature;
		const features = 'features' in land ? land.features : [land];

		ctx.fillStyle = '#fff';
		for (const f of features) {
			const g = f.geometry;
			const polygons =
				g.type === 'Polygon' ? [g.coordinates] : g.type === 'MultiPolygon' ? g.coordinates : [];
			for (const polygon of polygons) {
				const rings = polygon.map(unwrapRing);
				// Draw shifted copies so shapes crossing ±180° wrap around the map.
				for (const offset of [-360, 0, 360]) {
					ctx.beginPath();
					for (const ring of rings) {
						ring.forEach(([lon, lat], i) => {
							const x = ((lon + offset + 180) / 360) * width;
							const y = ((90 - lat) / 180) * height;
							i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
						});
						ctx.closePath();
					}
					ctx.fill('evenodd');
				}
			}
		}
		const { data } = ctx.getImageData(0, 0, width, height);
		return (lat: number, lon: number) => {
			const x = Math.min(width - 1, Math.floor(((lon + 180) / 360) * width));
			const y = Math.min(height - 1, Math.floor(((90 - lat) / 180) * height));
			return data[(y * width + x) * 4] > 128;
		};
	}

	function latLonToVector(lat: number, lon: number, r: number) {
		const phi = THREE.MathUtils.degToRad(90 - lat);
		const theta = THREE.MathUtils.degToRad(lon + 180);
		return new THREE.Vector3(
			-r * Math.sin(phi) * Math.cos(theta),
			r * Math.cos(phi),
			r * Math.sin(phi) * Math.sin(theta),
		);
	}

	// Shared with the render loop so dots know the canvas height in device pixels.
	const dotUniforms = {
		uColor: { value: DOT_COLOR },
		uEdgeColor: { value: EDGE_COLOR },
		uViewportHeight: { value: 1 },
		uMinPixels: { value: MIN_DOT_PIXELS },
		uDotDiameter: { value: DOT_SIZE * 2 },
	};

	/**
	 * Dots sit at the centre of equal-area-ish cells: rows every ROW_STEP_DEG of
	 * latitude, and each row split into as many cells as fit its circumference.
	 */
	function buildDots(isLand: (lat: number, lon: number) => boolean) {
		const positions: THREE.Vector3[] = [];
		for (let lat = -90 + ROW_STEP_DEG / 2; lat < 90; lat += ROW_STEP_DEG) {
			const perRow = Math.max(1, Math.round((360 / ROW_STEP_DEG) * Math.cos(THREE.MathUtils.degToRad(lat))));
			const cell = 360 / perRow;
			for (let i = 0; i < perRow; i++) {
				const lon = -180 + (i + 0.5) * cell;
				if (isLand(lat, lon)) positions.push(latLonToVector(lat, lon, RADIUS));
			}
		}

		// Each dot is a square quad; the fragment shader cuts a circle out of it
		// with a one-pixel soft edge (fwidth), so it stays smooth at any zoom.
		const material = new THREE.ShaderMaterial({
			transparent: true,
			depthWrite: false,
			uniforms: dotUniforms,
			// Dots smaller than a couple of pixels alias against the screen's pixel
			// grid (moiré). Below MIN_DOT_PIXELS we draw the dot bigger and fade it by
			// the same area ratio, so it covers the same amount of light but samples
			// cleanly. Squashed dots near the rim count by their thin side.
			vertexShader: /* glsl */ `
				uniform float uViewportHeight;
				uniform float uMinPixels;
				uniform float uDotDiameter;
				varying float vFacing;
				varying float vCoverage;
				varying float vEdge;
				varying vec2 vUv;
				void main() {
					vUv = uv;
					mat4 world = modelMatrix * instanceMatrix;
					vec3 center = (world * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
					vec3 normal = normalize(mat3(world) * vec3(0.0, 0.0, 1.0));
					vFacing = dot(normal, normalize(cameraPosition - center));

					vec4 clipCenter = projectionMatrix * viewMatrix * vec4(center, 1.0);
					float pixelsPerUnit = projectionMatrix[1][1] * 0.5 * uViewportHeight / clipCenter.w;
					// Radius in screen pixels along the dot's thin side.
					float radiusPx = 0.5 * uDotDiameter * pixelsPerUnit * max(vFacing, 0.05);
					float drawRadiusPx = max(radiusPx, 0.5 * uMinPixels);
					vCoverage = (radiusPx * radiusPx) / (drawRadiusPx * drawRadiusPx);

					// Grow the quad so there's room for a ~1px soft rim outside the circle.
					float grow = min((drawRadiusPx + 1.5) / radiusPx, 10.0);
					vEdge = drawRadiusPx / (radiusPx * grow); // circle edge in quad units (quad edge = 1)

					gl_Position = projectionMatrix * viewMatrix * world * vec4(position * grow, 1.0);
				}`,
			fragmentShader: /* glsl */ `
				uniform vec3 uColor;
				uniform vec3 uEdgeColor;
				varying float vFacing;
				varying float vCoverage;
				varying float vEdge;
				varying vec2 vUv;
				void main() {
					float d = length(vUv - 0.5) * 2.0; // 0 at centre, 1 at the quad edge
					float aa = fwidth(d); // about one screen pixel
					// ~2px soft transition centred on the circle edge: round when large,
					// a smooth blob (no pixel beating) when tiny.
					float alpha = 1.0 - smoothstep(vEdge - aa, vEdge + aa, d);
					if (alpha <= 0.0) discard;
					float t = smoothstep(0.0, 0.85, vFacing);
					gl_FragColor = vec4(mix(uEdgeColor, uColor, t), alpha * vCoverage);
				}`,
		});

		const geometry = new THREE.PlaneGeometry(DOT_SIZE * 2, DOT_SIZE * 2);
		const mesh = new THREE.InstancedMesh(geometry, material, positions.length);
		const m = new THREE.Matrix4();
		const q = new THREE.Quaternion();
		const forward = new THREE.Vector3(0, 0, 1);
		const one = new THREE.Vector3(1, 1, 1);
		positions.forEach((p, i) => {
			q.setFromUnitVectors(forward, p.clone().normalize());
			m.compose(p, q, one);
			mesh.setMatrixAt(i, m);
		});
		mesh.instanceMatrix.needsUpdate = true;
		return mesh;
	}

	/** Soft radial glow used behind each marker. */
	function makeGlowTexture() {
		const size = 128;
		const c = document.createElement('canvas');
		c.width = c.height = size;
		const ctx = c.getContext('2d')!;
		const g = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
		g.addColorStop(0, 'rgba(255,255,255,1)');
		g.addColorStop(0.25, 'rgba(255,255,255,0.45)');
		g.addColorStop(1, 'rgba(255,255,255,0)');
		ctx.fillStyle = g;
		ctx.fillRect(0, 0, size, size);
		const tex = new THREE.CanvasTexture(c);
		tex.colorSpace = THREE.SRGBColorSpace;
		return tex;
	}

	/** A crisp white disc with an anti-aliased rim, tinted by the material colour. */
	function makeDiscTexture() {
		const size = 256;
		const c = document.createElement('canvas');
		c.width = c.height = size;
		const ctx = c.getContext('2d')!;
		ctx.fillStyle = '#fff';
		ctx.beginPath();
		ctx.arc(size / 2, size / 2, size / 2 - 2, 0, Math.PI * 2);
		ctx.fill();
		const tex = new THREE.CanvasTexture(c);
		tex.colorSpace = THREE.SRGBColorSpace;
		tex.anisotropy = 4;
		return tex;
	}

	/** Blue dots floating just above the surface, each with a thin stem and a glow. */
	function buildMarkers() {
		const group = new THREE.Group();
		// Camera-facing discs (sprites) instead of low-poly spheres: always round.
		const dotMaterial = new THREE.SpriteMaterial({
			map: makeDiscTexture(),
			color: MARKER_COLOR,
			transparent: true,
			depthWrite: false,
		});
		const stemMaterial = new THREE.LineBasicMaterial({ color: MARKER_COLOR, transparent: true, opacity: 0.5 });
		const glowMaterial = new THREE.SpriteMaterial({
			map: makeGlowTexture(),
			color: MARKER_COLOR,
			transparent: true,
			opacity: 0.55,
			depthWrite: false,
			blending: THREE.AdditiveBlending,
		});

		for (const { name, lat, lon } of MARKERS) {
			const surface = latLonToVector(lat, lon, RADIUS);
			const top = latLonToVector(lat, lon, RADIUS + MARKER_HEIGHT);

			const dot = new THREE.Sprite(dotMaterial);
			dot.position.copy(top);
			dot.scale.setScalar(MARKER_SIZE * 2);
			dot.name = name;

			const stem = new THREE.Line(new THREE.BufferGeometry().setFromPoints([surface, top]), stemMaterial);

			const glow = new THREE.Sprite(glowMaterial);
			glow.position.copy(top);
			glow.scale.setScalar(MARKER_SIZE * 7);

			group.add(stem, dot, glow);
		}
		return group;
	}

	function buildAtmosphere() {
		return new THREE.Mesh(
			new THREE.SphereGeometry(RADIUS * 1.035, 64, 64),
			new THREE.ShaderMaterial({
				transparent: true,
				side: THREE.BackSide,
				depthWrite: false,
				vertexShader: /* glsl */ `
					varying vec3 vNormal;
					void main() {
						vNormal = normalize(normalMatrix * normal);
						gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
					}`,
				fragmentShader: /* glsl */ `
					varying vec3 vNormal;
					void main() {
						float rim = pow(0.65 - dot(vNormal, vec3(0.0, 0.0, 1.0)), 4.0);
						gl_FragColor = vec4(vec3(1.0), clamp(rim, 0.0, 1.0) * 0.12);
					}`,
			}),
		);
	}

	async function initGlobe(root: HTMLElement) {
		const canvas = root.querySelector('canvas')!;
		const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 100);

		const tilt = new THREE.Group();
		tilt.rotation.x = TILT;
		const spin = new THREE.Group();
		// Bring START_LON to the front (lon -90 faces +z at rotation 0).
		spin.rotation.y = THREE.MathUtils.degToRad(-90 - START_LON);
		tilt.add(spin);
		scene.add(tilt);

		// Dark body hides the dots on the far side.
		spin.add(
			new THREE.Mesh(
				new THREE.SphereGeometry(RADIUS * 0.995, 64, 64),
				new THREE.MeshBasicMaterial({ color: BODY_COLOR }),
			),
		);
		spin.add(buildMarkers());
		scene.add(buildAtmosphere());

		// --- Camera distance: "fit" shows the whole globe; zoom scales from there ---
		let fitDistance = 5;
		let zoom = 1; // 1 = whole globe in view; smaller = closer
		let zoomTarget = 1;
		const clampZoom = (z: number) =>
			THREE.MathUtils.clamp(z, (RADIUS * MIN_CAMERA_DISTANCE) / fitDistance, MAX_ZOOM_OUT);
		const applyZoom = () => {
			camera.position.z = fitDistance * zoom;
		};

		const resize = () => {
			const { clientWidth: w, clientHeight: h } = root;
			renderer.setSize(w, h, false);
			dotUniforms.uViewportHeight.value = h * renderer.getPixelRatio();
			camera.aspect = w / h;
			// Keep the whole globe (plus glow) in view on any aspect ratio.
			const fitHeight = (RADIUS * 1.25) / Math.tan(THREE.MathUtils.degToRad(camera.fov / 2));
			fitDistance = fitHeight / Math.min(1, camera.aspect);
			zoomTarget = clampZoom(zoomTarget);
			applyZoom();
			camera.updateProjectionMatrix();
		};
		new ResizeObserver(resize).observe(root);
		resize();

		// How much rotation a pixel of drag is worth: slower when zoomed in, so the
		// surface stays under your finger.
		const closeness = () => (camera.position.z - RADIUS) / (fitDistance - RADIUS);
		const radiansPerPixel = () =>
			((Math.PI / Math.min(root.clientWidth, root.clientHeight)) * 1.25) * closeness();
		const clampTilt = () => {
			tilt.rotation.x = THREE.MathUtils.clamp(tilt.rotation.x, -MAX_TILT, MAX_TILT);
		};

		// --- Mouse wheel / trackpad zoom ---
		root.addEventListener(
			'wheel',
			(e) => {
				e.preventDefault();
				// Trackpad pinch arrives as wheel + ctrlKey with small deltas.
				const speed = e.ctrlKey ? 0.01 : 0.0015;
				zoomTarget = clampZoom(zoomTarget * Math.exp(e.deltaY * speed));
			},
			{ passive: false },
		);

		// --- Drag to rotate (one pointer), pinch to zoom (two pointers) ---
		const pointers = new Map<number, { x: number; y: number }>();
		let dragging = false;
		let lastX = 0;
		let lastY = 0;
		let velX = 0; // radians per second around Y (spin)
		let velY = 0; // radians per second around X (tilt)
		let sinceRelease = RESUME_DELAY;
		let lastMoveTime = 0;
		let pinchStartDist = 0;
		let pinchStartZoom = 1;

		const pinchDistance = () => {
			const [a, b] = [...pointers.values()];
			return Math.hypot(a.x - b.x, a.y - b.y);
		};
		const startDrag = (x: number, y: number) => {
			dragging = true;
			lastX = x;
			lastY = y;
			lastMoveTime = performance.now();
			velX = velY = 0;
		};

		root.addEventListener('pointerdown', (e) => {
			pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
			root.setPointerCapture(e.pointerId);
			if (pointers.size === 1) {
				startDrag(e.clientX, e.clientY);
			} else if (pointers.size === 2) {
				dragging = false;
				velX = velY = 0;
				pinchStartDist = pinchDistance();
				pinchStartZoom = zoomTarget;
			}
		});
		root.addEventListener('pointermove', (e) => {
			if (!pointers.has(e.pointerId)) return;
			pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

			if (pointers.size >= 2) {
				const dist = pinchDistance();
				if (pinchStartDist > 0 && dist > 0) zoomTarget = clampZoom(pinchStartZoom * (pinchStartDist / dist));
				return;
			}
			if (!dragging) return;
			const now = performance.now();
			const dt = Math.max(1, now - lastMoveTime) / 1000;
			const k = radiansPerPixel();
			const dx = (e.clientX - lastX) * k;
			const dy = (e.clientY - lastY) * k;
			spin.rotation.y += dx;
			tilt.rotation.x += dy;
			clampTilt();
			// Smooth the release velocity so a quick flick feels natural.
			velX = THREE.MathUtils.clamp(THREE.MathUtils.lerp(velX, dx / dt, 0.5), -MAX_FLING, MAX_FLING);
			velY = THREE.MathUtils.clamp(THREE.MathUtils.lerp(velY, dy / dt, 0.5), -MAX_FLING, MAX_FLING);
			lastX = e.clientX;
			lastY = e.clientY;
			lastMoveTime = now;
		});
		const release = (e: PointerEvent) => {
			if (!pointers.delete(e.pointerId)) return;
			if (root.hasPointerCapture(e.pointerId)) root.releasePointerCapture(e.pointerId);

			if (pointers.size === 1) {
				// One finger lifted from a pinch: carry on rotating with the other.
				const [p] = [...pointers.values()];
				startDrag(p.x, p.y);
				return;
			}
			if (pointers.size === 0 && dragging) {
				dragging = false;
				sinceRelease = 0;
				// Holding still before letting go means no fling.
				if (performance.now() - lastMoveTime > 80) velX = velY = 0;
			}
		};
		root.addEventListener('pointerup', release);
		root.addEventListener('pointercancel', release);

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const clock = new THREE.Clock();
		renderer.setAnimationLoop(() => {
			const dt = Math.min(clock.getDelta(), 0.1);

			// Ease the camera towards the requested zoom.
			zoom += (zoomTarget - zoom) * (1 - Math.exp(-ZOOM_EASE * dt));
			applyZoom();

			if (!dragging && pointers.size === 0) {
				// Momentum from the last drag.
				const decay = Math.exp(-INERTIA_DECAY * dt);
				velX *= decay;
				velY *= decay;
				spin.rotation.y += velX * dt;
				tilt.rotation.x += velY * dt;
				clampTilt();
				// Auto-spin fades back in after a release, and slows when zoomed in.
				sinceRelease += dt;
				const resume = THREE.MathUtils.smoothstep(sinceRelease, 0, RESUME_DELAY);
				if (!reduceMotion.matches) spin.rotation.y += SPIN_SPEED * resume * closeness() * dt;
			}
			renderer.render(scene, camera);
		});

		// Land data arrives after the first frames; dots pop in once it's parsed.
		const topo = await fetch(landUrl).then((r) => r.json());
		spin.add(buildDots(buildLandMask(topo)));
	}

	document.querySelectorAll<HTMLElement>('[data-globe]').forEach((root) => void initGlobe(root));
</script>
