---
import '../styles/global.css';
import Globe from '../components/Globe.astro';

// Prefix for files in public/ (the site is served from /global-travel/ on GitHub Pages).
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Global Travel</title>
	</head>
	<body class="m-0 bg-[#0b0b0b] text-white">
		<main class="h-dvh w-full overflow-hidden">
			<Globe />
		</main>
	</body>
</html>
